font_family Google Sans Flex
font_size 13

disable_ligature no
enable_audio_bell no

shell zsh
shell_integration disable
shell_integration no-cursor

cursor_shape block

remember_window_size no
window_padding_width 25

background_opacity 0.85
scrollbar_handle_opacity 0
scrollbar_track_opacity 0
scrollbar_track_hover_opacity 0
confirm_os_window_close 0

sync_to_monitor no

# Kitty Color Theme - Lighter Rainy Forest
background            #1a241e
foreground            #dce6dc
cursor                #8ca07a
selection_background  #2d3b32
selection_foreground  #ffffff

# Black
color0 #1a241e
color8 #2d3b32

# Red (Soft Earth)
color1 #6b5252
color9 #8c6b6b

# Green (Lush Moss)
color2  #547a5f
color10 #7ba689

# Yellow (Sage)
color3  #8ca07a
color11 #a9c296

# Blue (Distant Fog)
color4  #56696b
color12 #738a8c

# Magenta (Rosewood)
color5  #695264
color13 #8a6c84

# Cyan (Cool Mist)
color6  #7ba19b
color14 #9cc2bd

# White
color7  #dce6dc
color15 #f0f5f0

cursor_trail 10
cursor_trail_start_threshold 0
cursor_trail_decay 0.01 0.08
cursor_shape block
cursor_blink true
